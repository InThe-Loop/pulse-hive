# Local Docker Compose environment.
# Replace local-only placeholders before using anything outside development.
NODE_ENV=development
API_PORT=4000
ALLOWED_ORIGINS=*
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# Infrastructure credentials and internal network URLs.
POSTGRES_USER=pulsehive
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_DB=pulsehive
DATABASE_URL=postgresql://pulsehive:local-postgres-password@postgres:5432/pulsehive?schema=public
RABBITMQ_DEFAULT_USER=pulsehive
RABBITMQ_DEFAULT_PASS=local-rabbitmq-password
RABBITMQ_URL=amqp://pulsehive:local-rabbitmq-password@rabbitmq:5672

# Generate unique, private values for all secrets before deployment.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-internal-key
JWT_SECRET=replace-with-a-long-random-admin-jwt-secret
CUSTOMER_JWT_SECRET=replace-with-a-long-random-customer-jwt-secret
CUSTOMER_OTP_SECRET=replace-with-a-long-random-otp-secret

# Service discovery used by Compose.
PULSEHIVE_AUTH_SERVICE_URL=http://auth:4001
PULSEHIVE_ORDERS_SERVICE_URL=http://orders:4002
PULSEHIVE_DB_SERVICE_URL=http://db:4003
PULSEHIVE_EVENTS_SERVICE_URL=http://events:5000

# Tenant and auth/email settings.
PULSEHIVE_TENANT_CODE=GLV-000001
ADMIN_APP_URL=http://localhost:3001
RESEND_API_KEY=
EMAIL_FROM="PulseHive <no-reply@example.com>"

# Optional external checkout integration. Compose currently does not pass
# these Ozow values into the web container; see docs/docker.md.
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_IS_TEST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local frontend configuration when running apps outside Compose.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CUSTOMER_AUTH_URL=http://localhost:4001
NEXT_PUBLIC_CONTACT_EMAIL=
