generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String             @id @default(cuid())
  name        String
  createdAt   DateTime           @default(now())
  slug        String             @unique
  updatedAt   DateTime           @updatedAt
  tenantCode  String             @unique
  customers   Customer[]
  orders      Order[]
  payments    Payment[]
  products    Product[]
  memberships UserTenant[]
  invitations TenantInvitation[]

  @@index([slug])
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  password                String
  role                    String                   @default("user")
  emailVerifiedAt         DateTime?
  displayName             String?
  bio                     String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             UserTenant[]
  emailVerificationTokens EmailVerificationToken[]
  sentTenantInvitations   TenantInvitation[]       @relation("TenantInvitationInviter")

  @@index([createdAt])
}

model UserTenant {
  id        String           @id @default(cuid())
  userId    String
  tenantId  String
  role      TenantRole       @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, status])
}

model TenantInvitation {
  id              String     @id @default(cuid())
  tenantId        String
  email           String
  role            TenantRole @default(MEMBER)
  tokenHash       String     @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("TenantInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, email])
  @@index([expiresAt])
  @@index([invitedByUserId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Global customer identity.
// One identity can be associated with customer profiles across multiple tenants.
model CustomerIdentity {
  id              String    @id @default(cuid())
  phone           String    @unique
  phoneVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customers Customer[]

  @@index([phoneVerifiedAt])
  @@index([isActive])
}

// OTP challenges are global and independent of tenant accounts.
// Only the hashed OTP is stored.
model CustomerOtpChallenge {
  id          String    @id @default(cuid())
  phone       String
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@index([phone, consumedAt, expiresAt])
}

model Customer {
  id                 String   @id @default(cuid())
  tenantId           String
  customerIdentityId String?
  name               String
  phone              String?
  email              String?
  address            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerIdentity CustomerIdentity? @relation(fields: [customerIdentityId], references: [id], onDelete: SetNull)
  orders           Order[]

  @@unique([tenantId, customerIdentityId])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([customerIdentityId])
}

model Product {
  id            String        @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  sku           String?
  image         String?
  size          String?
  price         Decimal       @db.Decimal(10, 2)
  catalogueType CatalogueType @default(PRODUCT)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems    OrderItem[]
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, catalogueType, status])
  @@index([tenantId, catalogueType, status, createdAt, id])
  @@index([tenantId, sku])
}

model Order {
  id              String           @id @default(cuid())
  tenantId        String
  reference       String
  totalAmount     Decimal          @db.Decimal(10, 2)
  trackingNumber  String?
  createdAt       DateTime         @default(now())
  customerId      String?
  deliveryAddress String?
  idempotencyKey  String?
  paymentStatus   PaymentStatus    @default(PENDING)
  shippingFee     Decimal          @db.Decimal(10, 2)
  shippingMethod  String?
  subtotal        Decimal          @db.Decimal(10, 2)
  updatedAt       DateTime         @updatedAt
  status          OrderStatus      @default(PENDING_PAYMENT)
  customer        Customer?        @relation(fields: [customerId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  payments        Payment[]
  fulfilment      OrderFulfilment?

  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  sku         String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderFulfilment {
  id                 String           @id @default(cuid())
  orderId            String           @unique
  status             FulfilmentStatus @default(NOT_STARTED)
  deliveryProvider   String?
  trackingReference  String?
  operationalNotes   String?
  startedAt          DateTime?
  packedAt           DateTime?
  readyForDispatchAt DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  order   Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  history OrderFulfilmentHistory[]

  @@index([status])
}

model OrderFulfilmentHistory {
  id             String            @id @default(cuid())
  fulfilmentId   String
  previousStatus FulfilmentStatus?
  newStatus      FulfilmentStatus
  actorUserId    String?
  note           String?
  createdAt      DateTime          @default(now())

  fulfilment OrderFulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)

  @@index([fulfilmentId, createdAt])
  @@index([actorUserId])
}

model Payment {
  id                    String          @id @default(cuid())
  tenantId              String
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  amount                Decimal         @db.Decimal(10, 2)
  orderId               String?
  createdAt             DateTime        @default(now())
  completedAt           DateTime?
  currency              String          @default("ZAR")
  provider              PaymentProvider
  providerReference     String?
  status                PaymentStatus   @default(PENDING)
  transactionReference  String?
  providerOptional1     String?
  providerOptional2     String?
  providerOptional3     String?
  providerOptional4     String?
  providerOptional5     String?
  providerStatusMessage String?
  paymentRequestId      String?
  gatewayUrl            String?
  updatedAt             DateTime        @updatedAt
  order                 Order?          @relation(fields: [orderId], references: [id])
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, transactionReference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, orderId])
  @@index([providerReference])
}

enum CatalogueType {
  PRODUCT
  COMBO_SPECIAL
  RESELLER_PACK
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  OZOW
  PAYFAST
  PAYSTACK
  MANUAL
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum FulfilmentStatus {
  NOT_STARTED
  PROCESSING
  PACKED
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  ON_HOLD
  DELIVERY_FAILED
}